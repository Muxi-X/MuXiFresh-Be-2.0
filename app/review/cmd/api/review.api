syntax = "v1"

info (
	title:  "review"
	desc:   "api( get userinfo )and( review )"
	author: "BIGDUST"
	email:  "3264085417@qq.com"
)

//获取审阅界面
type GetReviewReq {
	Authorization string `header:"Authorization"`
	Year          int    `json:"year"`
	Group         string `json:"group,options=[All,Product,Design,Frontend,Backend,Android,Operation]"`
	Season        string `json:"season,options=[autumn,spring]"`
	Grade         string `json:"grade,optional"`
	School        string `json:"school,optional"`
	Status        string `json:"status,optional"`
	Name          string `json:"name,optional"`
	Page          int64  `json:"page,optional,default=1"`
	PageSize      int64  `json:"page_size,optional"`
}

type Row {
	Name                string `json:"name"`
	Grade               string `json:"grader"`
	School              string `json:"school"`
	Group               string `json:"group"`
	Gender              string `json:"gender"`
	Major               string `json:"major"`
	Phone               string `json:"phone"`
	QQ                  string `json:"qq"`
	FormID              string `json:"form_id"`
	UserId              string `json:"user_id"`
	AdmissionStatus     string `json:"admission_status"`
	ScheduleID          string `json:"schedule_id"`
	Understanding       string `json:"understanding"`
	Reason              string `json:"reason"`
	SelfIntro           string `json:"selfintro"`
	ExtraQuestion       string `json:"extra_question"`
	InterviewComment    string `json:"interview_comment"`
	InterviewCommentRev int64  `json:"interview_comment_rev"`
}

type GetReviewResp {
	Rows  []Row `json:"rows"`
	Total int64 `json:"total"`
}

//调整录取状态
type SetAdmissionStatusReq {
	Authorization string `header:"Authorization"`
	ScheduleID    string `json:"schedule_id"`
	NewStatus     string `json:"new_status,options=[已报名,实习期,已转正]"`
}

type SetAdmissionStatusResp {
	Flag bool `json:"flag"`
}

//填写/更新面试评价（markdown 正文，空串清空；rev 为乐观锁版本号，首次填写传 0）
type SetInterviewCommentReq {
	Authorization string `header:"Authorization"`
	FormID        string `json:"form_id"`
	Comment       string `json:"comment"`
	Rev           int64  `json:"rev,optional,default=0"`
}

type SetInterviewCommentResp {
	Flag bool  `json:"flag"`
	Rev  int64 `json:"rev"`
}

// 导出 Excel 请求
type ExportReviewExcelReq {
	Authorization string `header:"Authorization"`
	Year          int    `json:"year"`
	Season        string `json:"season,options=[autumn,spring]"`
	Group         string `json:"group,optional,options=[All,Product,Design,Frontend,Backend,Android,Operation]"` // 为空或 All 时导出所有组
	Grade         string `json:"grade,optional"`
	School        string `json:"school,optional"`
	Status        string `json:"status,optional"`
}

@server (
	prefix: /api/v2
	jwt:    JwtAuth
)
service review {
	@doc "审阅界面"
	@handler GetReview
	post /review (GetReviewReq) returns (GetReviewResp)

	@doc "调整录取状态"
	@handler SetAdmissionStatus
	post /review/admission_status (SetAdmissionStatusReq) returns (SetAdmissionStatusResp)

	@doc "填写/更新面试评价"
	@handler SetInterviewComment
	post /review/interview_comment (SetInterviewCommentReq) returns (SetInterviewCommentResp)

	@doc "一键导出 Excel（包含每个组的名单）。返回 xlsx 二进制流（application/vnd.openxmlformats-officedocument.spreadsheetml.sheet），文件名在 Content-Disposition 响应头"
	@handler ExportReviewExcel
	post /review/export (ExportReviewExcelReq)
}

