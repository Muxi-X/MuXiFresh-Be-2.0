syntax = "v1"

info (
	title: "报名"
	desc: "与报名有关内容"
	author: "Ciel"
	email: "1622284619@qq.com"
)

//判断身份
type ClickReq {
	Authorization string `header:"Authorization"`
}
type ClickResp {
	UserType   string `json:"user_type"`
	FormStatus string `json:"form_status"`
}

//提交报名表
type CreateReq {
	Authorization string `header:"Authorization"`
	FormId        string `json:"form_id,optional"`
	Avatar        string `json:"avatar"`
	Major         string `json:"major"`
	Grade         string `json:"grade"`
	Gender        string `json:"gender"`
	Phone         string `json:"phone"`
	Group         string `json:"group,options=[Product,Design,Frontend,Backend,Android,Operation]"`
	Reason        string `json:"reason"`
	Knowledge     string `json:"knowledge"`
	SelfIntro     string `json:"self_intro"`
	ExtraQuestion string `json:"extra_question"`
}

type CreateResp {
	Flag bool `json:"flag"`
}

//查看报名表
type CheckReq {
	Authorization string `header:"Authorization"`
	EntryFormID   string `form:"entry_form_id"`
}

type CheckResp {
	FormId        string `json:"form_id"`
	Avatar        string `json:"avatar"`
	Major         string `json:"major"`
	Grade         string `json:"grade"`
	Gender        string `json:"gender"`
	Phone         string `json:"phone"`
	Group         string `json:"group"`
	Reason        string `json:"reason"`
	Knowledge     string `json:"knowledge"`
	SelfIntro     string `json:"self_intro"`
	ExtraQuestion string `json:"extra_question"`
}

//查询报名截止时间；cycle 省略时取当前届次
type GetRecruitDeadlineReq {
	Cycle string `form:"cycle,optional"`
}

type GetRecruitDeadlineResp {
	Cycle    string `json:"cycle"`
	Deadline string `json:"deadline"`
	Rev      int64  `json:"rev"`
}

//设置报名截止时间（rev 为乐观锁版本号，首次写入传 0）
type SetRecruitDeadlineReq {
	Authorization string `header:"Authorization"`
	Cycle         string `json:"cycle"`
	Deadline      string `json:"deadline"`
	Rev           int64  `json:"rev,optional,default=0"`
}

type SetRecruitDeadlineResp {
	Cycle    string `json:"cycle"`
	Deadline string `json:"deadline"`
	Rev      int64  `json:"rev"`
}

@server(
	prefix: api/v2
)

service form-api {
	@doc"查询报名截止时间"
	@handler GetRecruitDeadline
	get /recruit/deadline (GetRecruitDeadlineReq) returns(GetRecruitDeadlineResp)
}

@server(
	prefix: api/v2
	jwt: JwtAuth
)

service form-api {
	@doc"判断身份"
	@handler JudgeUser
	get /form/judge (ClickReq)returns(ClickResp)

	@doc"创建表"
	@handler CreateForm
	post /form (CreateReq)returns(CreateResp)

	@doc"编辑表"
	@handler UpdateForm
	put /form (CreateReq)returns(CreateResp)

	@doc"查看表"
	@handler CheckForm
	get /form/view(CheckReq)returns(CheckResp)

	@doc"设置报名截止时间"
	@handler SetRecruitDeadline
	put /recruit/deadline (SetRecruitDeadlineReq) returns(SetRecruitDeadlineResp)

}
